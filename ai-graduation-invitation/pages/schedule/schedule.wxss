/* pages/schedule/schedule.wxss */
.page {
  padding: 24rpx;
}

.head {
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #1e2f7a, #3b53e0);
  color: #fff;
}

.head-date {
  font-size: 30rpx;
  font-weight: 600;
}

.head-place {
  font-size: 26rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 时间轴 */
.tl-item {
  display: flex;
}

.tl-time {
  width: 96rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
  padding-top: 34rpx;
  flex-shrink: 0;
}

.tl-rail {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.tl-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #c9d2f5;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #c9d2f5;
  margin-top: 38rpx;
  flex-shrink: 0;
}

.tl-dot.hl {
  background: var(--gold);
  box-shadow: 0 0 0 2rpx #f8d48a;
}

.tl-line {
  width: 3rpx;
  flex: 1;
  background: #dde3f3;
}

.tl-body {
  flex: 1;
  padding-left: 16rpx;
  padding-bottom: 28rpx;
}

.tl-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(30, 47, 122, 0.05);
}

.tl-card.hl-card {
  background: linear-gradient(135deg, #fff8ea, #fff3d6);
  border: 1rpx solid #f5dfae;
}

.tl-title {
  font-size: 30rpx;
  font-weight: 700;
}

.badge {
  font-size: 20rpx;
  color: #b4750a;
  background: #fdeec8;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}

.tl-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
  line-height: 1.6;
}

.tl-place {
  font-size: 22rpx;
  color: #98a1b5;
  margin-top: 12rpx;
}
