/* pages/guide/guide.wxss */
.page {
  padding: 24rpx;
}

.card {
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  margin-bottom: 20rpx;
}

.row:last-child {
  margin-bottom: 0;
}

.row-tag {
  flex-shrink: 0;
  width: 96rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary);
}

.row-text {
  flex: 1;
  font-size: 26rpx;
  color: #3c4257;
  line-height: 1.7;
}

/* 常见问题折叠面板 */
.faq-item {
  border-bottom: 1rpx solid #eef1f7;
  padding: 24rpx 0;
}

.faq-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
}

.faq-arrow {
  color: #98a1b5;
  font-size: 22rpx;
  transition: transform 0.2s;
}

.faq-arrow.open {
  transform: rotate(90deg);
}

.faq-a {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
}
