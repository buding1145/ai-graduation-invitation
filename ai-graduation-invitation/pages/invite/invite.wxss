/* pages/invite/invite.wxss */
.page {
  min-height: 100vh;
}

/* ===== 封面 ===== */
.hero {
  position: relative;
  height: 640rpx;
  background: linear-gradient(160deg, #1e2f7a 0%, #3b53e0 55%, #6a3df0 100%);
  overflow: hidden;
}

.neural {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-inner {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.cap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.college {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  text-indent: 12rpx;
}

.chip {
  margin-top: 18rpx;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.75);
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
}

.title {
  margin-top: 40rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffd76a;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
}

.divider {
  width: 72rpx;
  height: 6rpx;
  background: #ffd76a;
  border-radius: 3rpx;
  margin: 28rpx 0;
}

.slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 4rpx;
}

/* ===== 主体 ===== */
.body {
  padding: 0 24rpx 40rpx;
  margin-top: -40rpx;
  position: relative;
}

.body .card {
  margin-bottom: 24rpx;
}

/* 身份选择 */
.seg {
  display: flex;
  background: #eef1fa;
  border-radius: 20rpx;
  padding: 8rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 14rpx;
}

.seg-item.on {
  background: linear-gradient(135deg, var(--primary), var(--violet));
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(59, 83, 224, 0.3);
}

.greeting {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #3c4257;
  background: #f6f8ff;
  border-radius: 16rpx;
  padding: 24rpx;
}

/* 倒计时 */
.cd-card {
  background: linear-gradient(135deg, #1e2f7a, #3b53e0);
  color: #fff;
}

.cd-label {
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

.cd-row {
  display: flex;
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.cd-box {
  flex: 1;
  margin: 0 10rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 18rpx;
  padding: 20rpx 0;
  text-align: center;
}

.cd-num {
  font-size: 48rpx;
  font-weight: 700;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}

.cd-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

/* 典礼信息 */
.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.info-row:last-of-type {
  margin-bottom: 8rpx;
}

.ico {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.info-main {
  flex: 1;
}

.info-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

.info-value {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.info-sub {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.copy {
  color: var(--primary);
  margin-left: 8rpx;
}

.btn-row {
  display: flex;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  margin: 0 10rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  text-align: center;
  font-weight: 600;
}

.btn.ghost {
  color: var(--primary);
  border: 2rpx solid rgba(59, 83, 224, 0.4);
  background: #f6f8ff;
}

.btn.solid {
  color: #fff;
  background: linear-gradient(135deg, var(--primary), var(--violet));
  box-shadow: 0 8rpx 18rpx rgba(59, 83, 224, 0.3);
}

/* 快捷入口 */
.grid {
  display: flex;
  margin-bottom: 24rpx;
}

.grid-item {
  flex: 1;
  background: #fff;
  border-radius: var(--radius);
  padding: 30rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(30, 47, 122, 0.06);
}

.grid-item + .grid-item {
  margin-left: 20rpx;
}

.grid-ico {
  font-size: 48rpx;
}

.grid-text {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
}

/* 分享按钮 */
.share-btn {
  width: 100%;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #f5b83d, #f08c2e);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  box-shadow: 0 10rpx 24rpx rgba(240, 140, 46, 0.35);
}

/* 页脚 */
.footer {
  text-align: center;
  padding: 48rpx 0 16rpx;
}

.footer-line {
  width: 48rpx;
  height: 4rpx;
  background: #d5dbe8;
  border-radius: 2rpx;
  margin: 0 auto 24rpx;
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.footer-slogan {
  font-size: 22rpx;
  color: #a5adc0;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}
